# Regras identificadas via audit2allow durante trabalho de enforcing
# Denials de "process getattr" (checagem de existência de processo) e
# leituras de contexto SELinux (/proc/<pid>/attr/current) usadas por
# telephony/installd/surfaceflinger/system_server em operações normais.

# installd — freezer de apps (Android 12+)
allow installd self:capability sys_ptrace;
allow installd system_server:dir search;
allow installd system_server:file { open read };
allow installd system_server:process getattr;

# radio — leitura de contexto de outros processos (telephony)
allow radio platform_app:file read;
allow radio platform_app:process getattr;
allow radio priv_app:dir search;
allow radio priv_app:file { open read };
allow radio priv_app:process getattr;
allow radio system_app:dir search;
allow radio system_app:file { open read };
allow radio system_app:process getattr;
allow radio system_server:dir search;
allow radio system_server:file { open read };
allow radio system_server:process getattr;
allow radio untrusted_app_29:dir search;

# surfaceflinger — checagem de existência de processos de apps
allow surfaceflinger permissioncontroller_app:process getattr;
allow surfaceflinger platform_app:process getattr;
allow surfaceflinger priv_app:process getattr;
allow surfaceflinger system_app:process getattr;
allow surfaceflinger system_server:process getattr;
allow surfaceflinger untrusted_app_29:process getattr;

# system_server — checagem de existência de processos diversos
allow system_server audioserver:process getattr;
allow system_server bluetooth:process getattr;
allow system_server mediaextractor:process getattr;
allow system_server mediametrics:process getattr;
allow system_server mediaprovider:process getattr;
allow system_server mediaprovider_app:process getattr;
allow system_server network_stack:process getattr;
allow system_server permissioncontroller_app:process getattr;
allow system_server priv_app:process getattr;
allow system_server radio:process getattr;
allow system_server surfaceflinger:process getattr;
allow system_server system_app:process getattr;
allow system_server untrusted_app:process getattr;
allow system_server untrusted_app_29:process getattr;

# vold — checagem de existência do system_server
allow vold system_server:process getattr;

# apps — socket do zygote (usap pool)
allow platform_app zygote:unix_stream_socket getopt;
allow priv_app zygote:unix_stream_socket getopt;
allow untrusted_app zygote:unix_stream_socket getopt;
allow untrusted_app_29 zygote:unix_stream_socket getopt;

# leitura de propriedade de hardware qemu (galeria consultando prop de emulação)
allow untrusted_app_29 qemu_hw_prop:file read;

# storaged/updater_app — completando padrão de "process getattr"
allow system_server storaged:process getattr;
allow system_server updater_app:process getattr;
allow surfaceflinger updater_app:process getattr;
allow updater_app zygote:unix_stream_socket getopt;

# vendor_default_prop — completar para system_app (já existe regra igual para platform_app)
allow system_app vendor_default_prop:file { getattr open };

# Linker shim (TARGET_LD_SHIM_LIBS) verificando carregamento de camera.msm8953.so
# globalmente no sistema — comportamento esperado do mecanismo de shim.
allow system_app vendor_file:file { getattr read };
allow priv_app vendor_file:file { getattr read };
allow platform_app vendor_file:file { getattr read };
allow shell vendor_file:file { getattr read };
allow netd vendor_file:file { getattr read };

# Mais domínios completando o padrão "process getattr" / zygote getopt
allow system_server cameraserver:process getattr;
allow system_server system_suspend:process getattr;
allow system_server shell:process getattr;

# Linker shim também acionado pelo dex2oat durante compilação em background
allow dex2oat vendor_file:file { getattr read };

# Settings lendo informação de paginação do kernel (tela de armazenamento/memória)
allow system_app proc_pagetypeinfo:file { read open getattr };

# adb root inspecionando processos do sistema (uso ativo de debug via `adb root`)
allow adbroot self:capability sys_ptrace;
allow adbroot system_app:file read;
allow adbroot system_app:dir search;

# system_app (AsyncTask de armazenamento) chamando vold via binder
allow system_app vold:binder call;
allow vold system_app:process getattr;

# Completando regras de adbroot/radio já existentes
allow adbroot system_app:file open;
allow adbroot system_app:process getattr;
allow radio untrusted_app_29:file { read open };
allow radio untrusted_app_29:process getattr;

# Linker shim acionado pelo logpersist
allow logpersist vendor_file:file { getattr read };

# apexd — consulta de módulos via Settings
allow system_app apexd:binder call;
allow apexd self:capability sys_ptrace;

# init criando diretório de compatibilidade uid_* dentro de sysfs
# (padrão legado de kernels MSM8953/Android 8-9 para cgroups)
allow init sysfs:dir create;

# system_server verificando existência do mediaserver
allow system_server mediaserver:process getattr;

# TEMPORÁRIO: /sys/fs/cgroup deveria ser tipo cgroup2, mas o kernel atual
# (3.18, sem CONFIG_MEMCG/CGROUP_PIDS/CGROUP_BPF) nunca monta cgroup2 ali,
# deixando esse path como sysfs puro. Corrigir de vez exige rebuild do
# kernel com essas configs habilitadas (planejado para branch separado).
allow system_server sysfs:dir { read open };

# apexd verificando existência/contexto do system_server
allow apexd system_server:process getattr;
allow apexd system_server:file read;
allow apexd system_server:dir search;

# ueventd acessando nó de block device durante enumeração de hardware
allow ueventd block_device:blk_file { read open };

# logpersist — persistência do boot_log.txt em /cache (feature padrão)
allow logpersist self:capability dac_override;
allow logpersist cache_file:dir { read open write add_name };
allow logpersist cache_file:file { create append open getattr ioctl };

# vendor_init acessando diretório de dados do seemp (telemetria) — tipo
# é privado de plataforma apesar do nome "vendor_"
allow vendor_init vendor_seemp_data_file:dir getattr;

# Cgroup uid_* (mesmo problema sistêmico de cgroup2 ausente no kernel)
allow system_server sysfs:dir create;

# vendor_default_prop completando para mais domínios de app
allow untrusted_app vendor_default_prop:file { getattr open };
allow isolated_app vendor_default_prop:file { getattr open };

# Continuação de process getattr / zygote getopt
allow surfaceflinger mediaprovider:process getattr;
allow mediaprovider zygote:unix_stream_socket getopt;

# apexd/drmserver lendo contexto de system_app
allow apexd system_app:file read;
allow apexd system_app:dir search;
allow apexd system_app:process getattr;
allow drmserver system_app:dir search;
allow drmserver system_app:file read;

# system_app chamando netd via binder (AsyncTask de rede/configurações)
allow system_app netd:binder call;

# radio <-> surfaceflinger, direção que faltava
allow surfaceflinger radio:process getattr;
allow radio surfaceflinger:dir search;
allow radio surfaceflinger:file read;
allow radio surfaceflinger:process getattr;

# Galeria lendo propriedade de hardware qemu
allow untrusted_app_29 qemu_hw_prop:file { open getattr };

# App de Rádio FM acessando o tuner físico
allow system_app zygote:unix_stream_socket getopt;

# Completar radio -> surfaceflinger (faltava open)
allow radio surfaceflinger:file open;

# crash_dump lendo propriedade de plataforma
allow crash_dump hwservicemanager_prop:file { open getattr };

# Google Play Services (gmscore_app) — mesmo padrão de sempre, novo domínio
allow system_server gmscore_app:process getattr;
allow priv_app gmscore_app:process getattr;
allow priv_app gmscore_app:file read;
allow priv_app gmscore_app:dir search;
allow radio gmscore_app:process getattr;
allow radio gmscore_app:file read;
allow radio gmscore_app:dir search;
allow untrusted_app radio:process getattr;

# gmscore_app lendo propriedade vendor (mesmo padrão de platform_app/system_app)
allow gmscore_app vendor_default_prop:file { getattr open };

# system_server verificando existência do keystore
allow system_server keystore:process getattr;

# apexd/idmap/drmserver completando leitura de contexto do system_app
allow apexd system_app:file open;
allow idmap system_app:file { read open };
allow idmap system_app:dir search;
allow idmap system_app:process getattr;

# FUSE passthrough do MediaProvider (scoped storage) criando arquivo
# de controle interno (.bh) via kernel worker thread
allow kernel self:capability dac_override;
allow kernel mnt_user_file:dir search;
allow kernel mnt_user_file:lnk_file read;
allow kernel fuse:dir { search write add_name create };
allow kernel fuse:file { create open };

# Completar open() que faltou nas regras anteriores de gmscore_app
allow priv_app gmscore_app:file open;
allow radio gmscore_app:file open;

# surfaceflinger -> gmscore_app, direção que faltava
allow surfaceflinger gmscore_app:process getattr;

# surfaceflinger lendo cmdline do HAL de composição gráfica

# system_server verificando existência de mais processos vendor
allow system_server vendor_qtelephony:process getattr;
allow system_server vendor_dataservice_app:process getattr;
allow system_server secure_element:process getattr;

# surfaceflinger monitorando a animação de boot
allow surfaceflinger bootanim:dir search;
allow surfaceflinger bootanim:file { read open };

# Novos pares de process getattr / leitura de contexto
allow vold vdc:process getattr;
allow keystore vold:dir search;
allow keystore vold:file { read open };
allow keystore vold:process getattr;
allow vold apexd:process getattr;
allow apexd system_server:file open;
allow system_server statsd:process getattr;
allow system_server netd:process getattr;
allow system_server shared_relro:process getattr;
allow radio statsd:dir search;
allow radio statsd:file { read open };
allow radio statsd:process getattr;
allow radio network_stack:dir search;
allow radio network_stack:file { read open };
allow radio network_stack:process getattr;

# drmserver e installd completando leitura de contexto do system_app
allow drmserver system_app:file open;
allow drmserver system_app:process getattr;
allow system_app installd:binder call;
allow installd system_app:file read;
allow installd system_app:dir search;
allow installd system_app:file open;

# radio <-> untrusted_app (Chrome), completando o padrão de sempre
allow radio untrusted_app:dir search;
allow radio untrusted_app:file read;

# system_server verificando processos isolados (sandbox do Chrome: GPU/renderer)
allow system_server isolated_app:process getattr;

# app_zygote (processo pai dos isolados do Chrome) lendo propriedade vendor
allow app_zygote vendor_default_prop:file { read open getattr };

# Chrome (untrusted_app) lendo propriedades diversas no startup
allow untrusted_app aac_drc_prop:file { open getattr };
allow untrusted_app ab_update_gki_prop:file { open getattr };
allow untrusted_app adbd_prop:file { open getattr };

# Chrome consultando atributos do block device de userdata (provável
# checagem de espaço/criptografia de armazenamento)
allow untrusted_app userdata_block_device:blk_file getattr;

# priv_app (Google App / GSA) lendo propriedade vendor — faltava esse domínio
allow priv_app vendor_default_prop:file { open getattr };

# gmscore_app lendo propriedades de adbd
allow gmscore_app system_adbd_prop:file { read open getattr };
allow gmscore_app adbd_prop:file { read open getattr };

# installd verificando existência do system_app
allow installd system_app:process getattr;

# system_app chamando storaged/system_suspend via binder (AsyncTasks de Settings)
allow system_app storaged:binder call;
allow system_app system_suspend:binder call;
allow system_suspend system_app:file read;
allow system_suspend system_app:dir search;

# vendor_dataservice_app lendo contexto do system_app (novo domínio)
allow vendor_dataservice_app system_app:dir search;
allow vendor_dataservice_app system_app:file { read open };
allow vendor_dataservice_app system_app:process getattr;

# atfwd (vendor_qtelephony) usando socket do zygote
allow vendor_qtelephony zygote:unix_stream_socket getopt;

# radio -> untrusted_app, faltava open especificamente
allow radio untrusted_app:file open;
allow radio untrusted_app:process getattr;

# Completando system_suspend -> system_app (faltava open + process getattr)
allow system_suspend system_app:file open;
allow system_suspend system_app:process getattr;

# isolated_app (sandbox) lendo contexto do gmscore_app
allow isolated_app gmscore_app:dir search;
allow isolated_app gmscore_app:process getattr;
allow isolated_app gmscore_app:file read;
